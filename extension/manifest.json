{
  "manifest_version": 3,
  "name": "Mind World",
  "version": "1.6.0",
  "description": "Improve your AI prompts as you type. Your chat memory stays on your device. Works on Claude, ChatGPT, Gemini, Perplexity, and any AI chat site with Universal Mode.",
  "permissions": [
    "storage",
    "unlimitedStorage",
    "scripting",
    "offscreen"
  ],
  "host_permissions": [
    "https://claude.ai/*",
    "https://chatgpt.com/*",
    "https://gemini.google.com/*",
    "https://perplexity.ai/*",
    "https://mind-world.app/*",
    "https://mind-world-app-mv4yv.ondigitalocean.app/*",
    "https://api.anthropic.com/*"
  ],
  "optional_host_permissions": [
    "https://*/*",
    "http://*/*"
  ],
  "background": {
    "service_worker": "background.js"
  },
  "content_scripts": [
    {
      "matches": [
        "https://claude.ai/*",
        "https://chatgpt.com/*",
        "https://gemini.google.com/*",
        "https://perplexity.ai/*"
      ],
      "js": ["storage-utils.js", "content.js", "input-dock.js"],
      "run_at": "document_idle"
    }
  ],
  "action": {
    "default_popup": "popup.html",
    "default_icon": {
      "16": "icons/icon16.png",
      "48": "icons/icon48.png",
      "128": "icons/icon128.png"
    }
  },
  "icons": {
    "16": "icons/icon16.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  },
  "commands": {
    "improve-prompt": {
      "suggested_key": {
        "default": "Alt+Shift+M"
      },
      "description": "Improve current prompt with Mind World"
    }
  },
  "content_security_policy": {
    "extension_pages": "script-src 'self' 'wasm-unsafe-eval'; object-src 'self'; connect-src 'self' https://mind-world-app-mv4yv.ondigitalocean.app https://mind-world.app https://api.anthropic.com;"
  }
}
